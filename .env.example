# Local Postgres from docker-compose.yml (host port 5435 to avoid clashing with a local 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5435/clipmarket

# HMAC key for the signed session cookie. Any long random string works locally.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# Separate database used by the integration tests. Created by `pnpm db:migrate` against this URL.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5435/clipmarket_test
